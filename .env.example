# !! server configuration !!
PORT=10000
# Initial news version for a new database; existing databases keep their stored version.
NEWS_VERSION=5
MOTD=A GDPSnode Private Server.
# ICON=https://example.com/server-icon.png
# LANG=js
# Leave blank for direct/simple HTTP setups. Set the external URL when HTTPS terminates at a reverse proxy.
# PUBLIC_URL=https://gdps.example.com
# Relative paths are resolved from the directory where `npm start` is run.
# GDPS_DATABASE_PATH=gd_server.db

# !! webhooks !!
webhook=https://discord.com/api/webhooks/tung/dihh
#             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#                                      replace with your discord webhook
#if you leave the placeholder webhook the server will run as normal, but youll get notices in the console about the
# webhook. webhooks are completely optional :)

# !! dashboard login !!
# Dashboard auth now supports standard in-game moderator accounts via their username + password.
# If you still use the legacy single dashboard password, keep the following values for compatibility.
DASHBOARD_PATH=/dashboard
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_ACCOUNT_ID=0
DASHBOARD_SECURE_COOKIES=0
# account uses in-game moderator credentials; legacy uses the values above; both enables either method.
DASHBOARD_LOGIN_MODE=account

# Number of trusted reverse-proxy hops; use 0 when directly exposed.
TRUST_PROXY_HOPS=0

# !! plugins !!
ENABLE_PLUGINS=1
PLUGINS_DIR=plugins

# !! request limits !!
# Requests per minute per client IP across game and dashboard routes.
# Login attempts still have a separate, stricter dashboard limit below.
RATE_LIMIT_PER_MINUTE=350
# Dashboard login attempts per 15-minute window.
DASHBOARD_ATTEMPTS_PER_WINDOW=10

# !! custom song URLs !!
# Set when song files are served from a separate host or CDN.
# SONG_BASE_URL=https://songs.example.com/songs

# !! daily chest reward configuration !!
# Wait values are seconds; min/max reward values are inclusive. Uncomment to override defaults.
# CHEST1_WAIT=14400
# CHEST2_WAIT=86400
# CHEST1_MIN_ORBS=20
# CHEST1_MAX_ORBS=100
# CHEST1_MIN_DIAMONDS=1
# CHEST1_MAX_DIAMONDS=3
# CHEST1_MIN_KEYS=1
# CHEST1_MAX_KEYS=3
# CHEST2_MIN_ORBS=100
# CHEST2_MAX_ORBS=200
# CHEST2_MIN_DIAMONDS=5
# CHEST2_MAX_DIAMONDS=10
# CHEST2_MIN_KEYS=1
# CHEST2_MAX_KEYS=3