# !! dashboard login !!
# its highly recommended you change the path and password so they aren't easily found or guessed
DASHBOARD_PATH=/dashboard
# this must match the name of a real elder in your server
DASHBOARD_USER=elder
# this can be anything you want
DASHBOARD_PASSWORD=replace-with-a-long-random-password
# this must match the account id of a real elder in your server
DASHBOARD_ACCOUNT_ID=123

# if your server is going over https, you can set this to 1
DASHBOARD_SECURE_COOKIES=0
